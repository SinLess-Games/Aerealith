{
  "name": "observability",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/observability/src",
  "projectType": "library",
  "tags": ["scope:observability", "type:lib"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "tsc --noEmit -p libs/observability/tsconfig.lib.json",
          "tsc --noEmit -p libs/observability/tsconfig.spec.json"
        ],
        "parallel": false
      }
    },
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/observability",
        "main": "libs/observability/src/index.ts",
        "tsConfig": "libs/observability/tsconfig.lib.json",
        "assets": ["libs/observability/*.md"]
      }
    }
  }
}
