# PostgreSQL connection used by libs/db.
DATABASE_URL=postgresql://aerealith:aerealith@localhost:5432/aerealith
POSTGRES_DB=aerealith
POSTGRES_USER=aerealith
POSTGRES_PASSWORD=aerealith
POSTGRES_PORT=5432

# Resend credentials used for authentication email delivery.
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=Aerealith <auth@example.com>
FRONTEND_URL=http://localhost:4200

# Idempotent administrator seed migration.
ADMIN_USERNAME=Sinless777
ADMIN_EMAIL=timothy.pierce444@gmail.com
# Use at least 16 characters. If omitted, the seed prints a generated password once.
ADMIN_PASSWORD=replace_with_a_long_unique_password

# Local service and frontend proxy configuration.
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_URL=http://localhost:3001

# Observability configuration.
#
# Use the remote-write/ingestion URLs and credentials issued by your
# observability provider. Keep tokens out of source control.

# OpenTelemetry OTLP exporter shared by traces, metrics, and logs.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp.example.com
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Comma-separated key=value pairs. Replace this with the authentication
# headers issued by your observability provider.
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Bearer replace_with_your_otlp_token

# Prometheus metrics endpoint.
PROMETHEUS_METRICS_URL=https://prometheus.example.com/api/prom/push
PROMETHEUS_USER_ID=replace_with_your_prometheus_user_id
PROMETHEUS_TOKEN=replace_with_your_prometheus_token

# Loki logging endpoint.
LOKI_LOGGING_URL=https://loki.example.com/loki/api/v1/push
LOKI_NAME=aerealith
LOKI_USER_ID=replace_with_your_loki_user_id
LOKI_TOKEN=replace_with_your_loki_token

# Tempo tracing endpoint.
TEMPO_TRACING_URL=https://tempo.example.com/otlp
TEMPO_NAME=aerealith
TEMPO_USER_ID=replace_with_your_tempo_user_id
TEMPO_TOKEN=replace_with_your_tempo_token
