# PostgreSQL connection used by libs/db.
DATABASE_URL=postgresql://aerealith:aerealith@localhost:5432/aerealith
POSTGRES_DB=aerealith
POSTGRES_USER=aerealith
POSTGRES_PASSWORD=aerealith
POSTGRES_PORT=5432

# Resend credentials used for authentication email delivery.
RESEND_API_KEY=re_replace_with_your_resend_api_key
RESEND_FROM_EMAIL=Aerealith <auth@example.com>
FRONTEND_URL=http://localhost:4200

# Idempotent protected super-administrator seed.
ADMIN_USERNAME=Sinless777
ADMIN_EMAIL=timothy.pierce444@gmail.com
# Use at least 16 characters. If omitted, the seed prints a generated password once.
ADMIN_PASSWORD=replace_with_a_long_unique_password

# Local service and frontend proxy configuration.
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_URL=http://localhost:3001

# Observability configuration.
#
# Use the remote-write/ingestion URLs and credentials issued by your
# observability provider. Keep tokens out of source control.

# OpenTelemetry OTLP exporter shared by traces, metrics, and logs.
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-us-west-0.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# Comma-separated key=value pairs. Replace this with the authentication
# header issued by Grafana Cloud. Its value is Basic base64(user:token).
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic replace_with_base64_1740960_colon_token
OTEL_SERVICE_NAMESPACE=aerealith
OTEL_SERVICE_VERSION=development
# Parent-based probabilistic sampling; use always_on while debugging only.
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.25
OTEL_METRIC_EXPORT_INTERVAL=60000

# Prometheus metrics endpoint.
PROMETHEUS_METRICS_URL=https://prometheus-prod-67-prod-us-west-0.grafana.net/api/prom/push
PROMETHEUS_USER_ID=3406144
PROMETHEUS_TOKEN=replace_with_your_prometheus_token

# Loki logging endpoint.
LOKI_LOGGING_URL=https://logs-prod-021.grafana.net
LOKI_NAME=grafanacloud-sinlessindustries-logs
LOKI_USER_ID=1698747
LOKI_TOKEN=replace_with_your_loki_token

# Tempo tracing endpoint.
TEMPO_TRACING_URL=https://tempo-prod-15-prod-us-west-0.grafana.net/tempo
TEMPO_NAME=grafanacloud-sinlessindustries-traces
TEMPO_USER_ID=1693048
TEMPO_TOKEN=replace_with_your_tempo_token

# Grafana Cloud Profiles / Pyroscope.
PYROSCOPE_ENABLED=true
PYROSCOPE_SERVER_ADDRESS=https://profiles-prod-008.grafana.net
PYROSCOPE_APPLICATION_NAME=aerealith-auth
PYROSCOPE_BASIC_AUTH_USER=1740960
PYROSCOPE_BASIC_AUTH_PASSWORD=replace_with_your_pyroscope_token
PYROSCOPE_FLUSH_INTERVAL_MS=60000
PYROSCOPE_WALL_COLLECT_CPU_TIME=true

# Grafana Frontend Observability collector URL. This is the public ingestion
# URL generated when a Frontend Observability application is created.
VITE_GRAFANA_FARO_URL=
VITE_APP_ENVIRONMENT=development
VITE_APP_VERSION=development
