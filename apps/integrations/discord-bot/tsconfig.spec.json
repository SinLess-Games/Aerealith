{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "isolatedModules": true,
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "outDir": "../../../dist/out-tsc",
    "rootDir": "./src",
    "types": ["jest", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.spec.ts", "src/**/*.d.ts"],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
