{
  "name": "service-ai-orchestrator",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/services/ai-orchestrator/src",
  "projectType": "application",
  "tags": ["scope:services", "type:service", "domain:ai"],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit -p apps/services/ai-orchestrator/tsconfig.app.json" }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": { "lintFilePatterns": ["apps/services/ai-orchestrator/**/*.{ts,tsx,js,jsx}"] }
    },
    "worker-serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/services/ai-orchestrator", "command": "wrangler dev" }
    },
    "worker-dry-run": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/services/ai-orchestrator", "command": "wrangler deploy --dry-run" }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": { "cwd": "apps/services/ai-orchestrator", "command": "wrangler deploy" }
    }
  }
}
