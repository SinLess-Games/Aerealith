{
  "name": "service-ai-orchestrator",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/services/ai-orchestrator/src",
  "projectType": "application",
  "tags": ["scope:services", "type:service", "domain:ai"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": ["^build"],
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/services/ai-orchestrator",
        "main": "apps/services/ai-orchestrator/src/main.ts",
        "tsConfig": "apps/services/ai-orchestrator/tsconfig.app.json"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit -p apps/services/ai-orchestrator/tsconfig.app.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "options": {
        "lintFilePatterns": [
          "apps/services/ai-orchestrator/**/*.{ts,tsx,js,jsx}"
        ]
      }
    },
    "dev": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/services/ai-orchestrator",
        "command": "wrangler dev --port 8789 --inspector-port 9231 --env-file ../../../.env"
      }
    },
    "worker-serve": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/services/ai-orchestrator",
        "command": "wrangler dev"
      }
    },
    "worker-dry-run": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/services/ai-orchestrator",
        "command": "wrangler deploy --dry-run"
      }
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/services/ai-orchestrator",
        "command": "wrangler deploy"
      }
    },
    "test": {
      "executor": "@nx/vitest:test",
      "options": {
        "passWithNoTests": false,
        "configFile": "apps/services/ai-orchestrator/vitest.config.mts"
      }
    },
    "typegen": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/worker-configuration.d.ts"],
      "options": {
        "cwd": "apps/services/ai-orchestrator",
        "command": "wrangler types"
      }
    }
  }
}
