{
  "name": "frontend",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/frontend/src",
  "projectType": "application",
  "tags": ["scope:frontend", "type:app"],
  "// targets": "to see all targets run: nx show project frontend --web",
  "targets": {
    "generate-docs": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/source.config.ts",
        "{workspaceRoot}/libs/content/src/en/docs/**/*",
        { "externalDependencies": ["fumadocs-mdx"] }
      ],
      "outputs": ["{projectRoot}/.source"],
      "options": {
        "cwd": "apps/frontend",
        "command": "node ../../node_modules/fumadocs-mdx/bin.js source.config.ts .source"
      }
    },
    "typecheck": {
      "dependsOn": ["generate-docs"]
    },
    "dev-client": {
      "continuous": true,
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "vite"
      }
    },
    "dev": {
      "continuous": true,
      "dependsOn": [
        {
          "projects": ["service-auth", "service-api"],
          "target": "dev"
        }
      ],
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/frontend",
        "command": "vite"
      }
    }
  }
}
